{
    // ── CMake Tools ──────────────────────────────────────────────────────────
    // Build output goes here. CMake Tools reads this automatically.
    "cmake.buildDirectory": "${workspaceFolder}/build",

    // NOTHING MACHINE-SPECIFIC BELONGS IN THIS FILE — it is committed. A hardcoded
    // cmake.cmakePath / VULKAN_SDK used to live here and leaked a developer's home
    // directory into git history.
    //
    // CMake resolves from PATH, and VULKAN_SDK comes from the Vulkan SDK's own installer
    // (Windows: set globally; macOS/Linux: `source ~/VulkanSDK/<ver>/setup-env.sh`, which
    // also sets PATH, VK_LAYER_PATH and DYLD_LIBRARY_PATH). The Homebrew-CMake-4 failure
    // that motivated the pinned cmake path is fixed properly in CMakeLists.txt
    // (CMAKE_POLICY_VERSION_MINIMUM), so no pinned CMake is needed on any platform.
    //
    // If you genuinely need a per-machine override, put it in CMakeUserPresets.json
    // (gitignored) or VS Code *user* settings — never here.

    // Configure the project automatically when you open the folder
    "cmake.configureOnOpen": true,

    // Always build before launching (so F5 = build + run)
    "cmake.buildBeforeRun": true,

    // Pick the active target via the status bar (bottom of VS Code window)
    "cmake.defaultVariants": {
        "buildType": {
            "default": "debug",
            "choices": {
                "debug": {
                    "short": "Debug",
                    "long": "Disable optimizations, enable validation layers",
                    "buildType": "Debug"
                },
                "release": {
                    "short": "Release",
                    "long": "Enable optimizations, disable validation layers",
                    "buildType": "Release"
                }
            }
        }
    },

    // ── C/C++ IntelliSense ───────────────────────────────────────────────────
    // Tell the C++ extension to use compile_commands.json generated by CMake
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

    // ── Editor quality-of-life ───────────────────────────────────────────────
    "editor.formatOnSave": true,
    "files.associations": {
        "*.vert": "glsl",
        "*.frag": "glsl",
        "*.comp": "glsl"
    }
}
