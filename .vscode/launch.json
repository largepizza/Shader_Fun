{
    "version": "0.2.0",
    "configurations": [
        {
            // Press F5 to build (if needed) and launch with the debugger attached.
            // CMake Tools resolves the exe path and working directory.
            "name": "Debug SAT LIGHT SIM (macOS/Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "MIMode": "lldb",
            "environment": [
                {
                    "name": "VULKAN_SDK",
                    "value": "${env:VULKAN_SDK}"
                },
                {
                    "name": "VK_ICD_FILENAMES",
                    "value": "/usr/local/share/vulkan/icd.d/MoltenVK_icd.json"
                }
            ],
            "preLaunchTask": "CMake: build"
        },
        {
            // Original Windows configuration (uses the MSVC debugger).
            "name": "Debug SAT LIGHT SIM (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [],
            "preLaunchTask": "CMake: build"
        }
    ]
}
